{
  "manifest_version": 3,
  "name": "NoMalice AI Scam Shield",
  "version": "1.0.0",
  "description": "Scan selected or current webpage text for scams and phishing using NoMalice AI.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://hook.eu1.make.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nomalice-shield@example.com",
      "strict_min_version": "109.0"
    }
  }
}
