{
  "manifest_version": 3,
  "name": "NoMalice AI Scam Shield",
  "version": "1.1.0",
  "description": "Scan selected or current webpage text & URLs for scams, inspect shell commands statically, and audit workflow permissions.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://hook.eu1.make.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nomalice-shield@example.com",
      "strict_min_version": "109.0"
    }
  }
}
